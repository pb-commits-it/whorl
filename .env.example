# Required: OpenRouter API key for Qwen3-VL vision + reasoning calls
OPENROUTER_API_KEY=sk-or-v1-...

# Models
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash

# Dev settings — skip email send; log magic links to stdout (v0.2+)
WHORL_DEV_AUTH=1

# Local storage
WHORL_PHOTO_DIR=./photos
